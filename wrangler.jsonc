{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tools",
  "main": "src/worker.ts",
  "minify": true,
  "compatibility_date": "2026-09-30",
  // No compatibility flags: web standards and Effect only, no nodejs_compat.
  "compatibility_flags": [],
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  "routes": [{ "pattern": "tools.mikepage.nl", "custom_domain": true }],
  "observability": { "enabled": true }
}
