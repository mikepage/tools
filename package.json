{
  "name": "@mikepage/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Network and email tools on Effect and Cloudflare Workers, with one runtime dependency.",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx/jsx-runtime.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "deps": "node scripts/deps.ts"
  },
  "dependencies": {
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
